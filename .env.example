# Root-level example for local development.
# The backend reads backend/.env when run directly.
DATABASE_URL=postgresql+psycopg://campusflow:campusflow@localhost:5432/campusflow
CORS_ORIGINS=http://localhost:5173
# Secret used to sign API tokens. Set a long random value; never commit the real one.
SECRET_KEY=change-me-to-a-long-random-string
# Optional: external AI provider for the timetable assistant (rule-based fallback is used when unset).
# AI_PROVIDER=
# AI_API_KEY=
